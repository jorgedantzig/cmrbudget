# Cursor (local run / deploy)
# CURSOR_API_KEY=

# CMR buckets dashboard (Vercel password protection)
CMR_DASHBOARD_URL=https://budget-dashboards-sandy.vercel.app/buckets.html
CMR_DASHBOARD_PASSWORD=
# Alias also accepted by fetch-cmr-list:
# DASHBOARD_PASSWORD=

# Offline parse (optional). When password unset, tools default to the sample fixture.
# CMR_USE_FIXTURE=1
# CMR_FIXTURE_PATH=./fixtures/cmr-ceiba-sample.html

# Nova4a (stub until bridge is live)
NOVA4A_BRIDGE_URL=
NOVA4A_API_TOKEN=
NOVA4A_USERNAME=
NOVA4A_PASSWORD=
# NOVA4A_BASE_URL=https://app.nova4a.com

# RO Writer bridge on the shop PC (HTTP)
RO_BRIDGE_URL=
RO_BRIDGE_TOKEN=

# Slack — minted by: npx --yes "@grok/agent-sdk@0.4.0" slack create --dir . --name "CMR Quote"
# Do not hand-write bot/channels/slack.ts; let slack create scaffold it.
# CMR_QUOTE_SLACK_BOT_TOKEN=
# CMR_QUOTE_SLACK_APP_TOKEN=
